{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "appearance": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "colors": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "selectedBg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mdLink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "success": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "warning": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "userMessageBg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "userMessageText": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "thinkingText": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "toolDiffAdded": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "toolDiffRemoved": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "accent",
        "text",
        "muted",
        "border",
        "selectedBg",
        "mdLink",
        "success",
        "warning",
        "error",
        "userMessageBg",
        "userMessageText",
        "thinkingText",
        "toolDiffAdded",
        "toolDiffRemoved"
      ]
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "pageBg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cardBg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "infoBg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "pageBg",
        "cardBg",
        "infoBg"
      ]
    }
  },
  "required": [
    "name",
    "appearance",
    "colors",
    "surfaces"
  ]
}
